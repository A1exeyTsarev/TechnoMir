<Page x:Class="TechnoMir.Pages.OrderHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы — ТехноМир">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои заказы" Style="{StaticResource PageTitle}"/>

        <Grid Grid.Row="1">
            <ListView x:Name="lvOrders" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Expander>
                                <Expander.Header>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" FontSize="16"
                                                   Margin="0,0,16,0"/>
                                        <TextBlock Margin="0,0,16,0"
                                                   Text="{Binding OrderDate, StringFormat=от {0:dd.MM.yyyy HH:mm}}"/>
                                        <Border Background="{StaticResource AccentColor}" CornerRadius="3" Padding="6,1"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="{Binding StatusName, Mode=OneWay}" Foreground="White"/>
                                        </Border>
                                        <TextBlock FontWeight="Bold"
                                                   Text="{Binding TotalSum, Mode=OneWay, StringFormat=на сумму {0:N2} ₽}"/>
                                    </WrapPanel>
                                </Expander.Header>
                                <StackPanel Margin="24,8,0,0">
                                    <TextBlock>
                                        <Run Text="Пункт выдачи:" FontWeight="Bold"/>
                                        <Run Text="{Binding PickupAddress, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Дата доставки:" FontWeight="Bold"/>
                                        <Run Text="{Binding DeliveryDate, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}"/>
                                        <Run Text="   Код получения:" FontWeight="Bold"/>
                                        <Run Text="{Binding PickupCode, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding OrderItems}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="•"/>
                                                    <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                                    <Run Text="("/><Run Text="{Binding ColorName, Mode=OneWay}"/><Run Text=")"/>
                                                    <Run Text="—"/>
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                    <Run Text="шт. ×"/>
                                                    <Run Text="{Binding PricePerUnit, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                                                    <Run Text="="/>
                                                    <Run Text="{Binding Sum, Mode=OneWay, StringFormat={}{0:N2} ₽}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="txtEmpty" Text="Вы ещё ничего не заказывали." Style="{StaticResource MutedText}"
                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnBack" Content="В каталог" Style="{StaticResource SecondaryButton}"
                    Click="btnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>
