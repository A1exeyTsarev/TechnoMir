<Page x:Class="TechnoMir.Pages.ProductEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товар — редактирование — ТехноМир">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" MaxWidth="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Grid.ColumnSpan="3" Text="Новый товар" Style="{StaticResource PageTitle}"/>

            <!-- Поля товара -->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Артикул * (латиница, цифры, дефис)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtArticle" MaxLength="20"/>
                <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtName" MaxLength="255"/>
                <TextBlock Text="Категория *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbCategory" DisplayMemberPath="CategoryName"
                          SelectionChanged="cmbCategory_SelectionChanged"/>
                <TextBlock Text="Подкатегория *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbSubcategory" DisplayMemberPath="SubcategoryName"/>
                <TextBlock Text="Производитель *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbManufacturer" DisplayMemberPath="ManufacturerName"/>
                <TextBlock Text="Поставщик *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbSupplier" DisplayMemberPath="SupplierName"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Цена, ₽ *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtPrice" MaxLength="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Скидка, % (пусто — без скидки)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtDiscount" MaxLength="2" PreviewTextInput="Digits_PreviewTextInput"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtDescription" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True"
                         Height="60" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Характеристики" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtSpecifications" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True"
                         Height="60" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Фото и остатки -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Фото" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource Card}" Background="White" Margin="0,2">
                    <Image x:Name="imgProduct" Height="200" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="txtImagePath" Style="{StaticResource MutedText}"/>
                <WrapPanel>
                    <Button x:Name="btnChooseImage" Content="Выбрать фото…" Click="btnChooseImage_Click"/>
                    <Button x:Name="btnRemoveImage" Content="Убрать фото" Style="{StaticResource SecondaryButton}"
                            Click="btnRemoveImage_Click"/>
                </WrapPanel>

                <TextBlock Text="Остатки по цветам" FontWeight="Bold" FontSize="16" Margin="0,14,0,0"/>
                <DataGrid x:Name="dgStock" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" Height="150" Margin="0,4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Цвет" Binding="{Binding ColorName}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" IsReadOnly="True" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ComboBox x:Name="cmbStockColor" DisplayMemberPath="ColorName"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtStockQuantity" Width="80" MaxLength="4"
                             PreviewTextInput="Digits_PreviewTextInput" ToolTip="Количество на складе"/>
                    <Button x:Name="btnSetStock" Content="Задать остаток" Click="btnSetStock_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Остаток сохраняется вместе с товаром кнопкой «Сохранить»."/>
            </StackPanel>

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <Button x:Name="btnSaveChanges" Content="Сохранить" Click="btnSaveChanges_Click"/>
                <Button x:Name="btnCancel" Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Click="btnCancel_Click"/>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Page>
