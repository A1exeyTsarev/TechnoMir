<Page x:Class="TechnoMir.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товар — ТехноМир">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" MaxWidth="980">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Background="White"
                    VerticalAlignment="Top" Margin="0,0,20,0">
                <Image Source="{Binding ImageSource}" Width="260" Height="260" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource MutedText}">
                    <Run Text="Артикул:"/> <Run Text="{Binding Article}"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="Категория:" FontWeight="Bold"/>
                    <Run Text="{Binding Subcategories.FullName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Производитель:" FontWeight="Bold"/>
                    <Run Text="{Binding ManufacturerName, Mode=OneWay}"/>
                    <Run Text="("/><Run Text="{Binding Manufacturers.Country}"/><Run Text=")"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Поставщик:" FontWeight="Bold"/>
                    <Run Text="{Binding Suppliers.SupplierName}"/>
                </TextBlock>
                <TextBlock Text="Описание" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                <TextBlock Text="Характеристики" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Specifications}" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock FontSize="22" FontWeight="{Binding PriceWeight}" VerticalAlignment="Center"
                               Text="{Binding FinalPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                    <TextBlock FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" TextDecorations="Strikethrough"
                               Visibility="{Binding OldPriceVisibility}"
                               Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
                    <Border Background="{StaticResource DangerColor}" CornerRadius="3" Padding="6,1"
                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding OldPriceVisibility}">
                        <TextBlock Text="{Binding DiscountText}" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Выбор цвета и количества -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Цвет" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbColor" Width="280" HorizontalAlignment="Left"
                                  ItemsSource="{Binding AvailableColors, Mode=OneWay}"
                                  DisplayMemberPath="ColorWithQuantity"/>
                        <TextBlock Text="Количество" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtQuantity" Width="100" HorizontalAlignment="Left" Text="1" MaxLength="3"
                                 PreviewTextInput="txtQuantity_PreviewTextInput"/>
                        <TextBlock x:Name="txtNoStock" Text="Товара нет в наличии." Foreground="{StaticResource DangerColor}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="btnAddToCart" Content="В корзину" Click="btnAddToCart_Click"/>
                    <Button x:Name="btnGoToCart" Content="Перейти в корзину" Click="btnGoToCart_Click"/>
                    <Button x:Name="btnEditProduct" Content="Изменить товар" Click="btnEditProduct_Click"/>
                    <Button x:Name="btnBack" Content="Назад" Style="{StaticResource SecondaryButton}"
                            Click="btnBack_Click"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
