<Page x:Class="TechnoMir.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет — ТехноМир">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" MaxWidth="820">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Личный кабинет" Style="{StaticResource PageTitle}"/>

            <!-- Личные данные -->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Мои данные" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Фамилия *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtSurname" MaxLength="100"/>
                <TextBlock Text="Имя *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtFirstName" MaxLength="100"/>
                <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPatronymic" MaxLength="100"/>
                <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail" MaxLength="150"/>
                <TextBlock Text="Телефон *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPhone" MaxLength="20"/>
                <TextBlock Text="Роль (меняет только администратор)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtRole" IsReadOnly="True" Background="{StaticResource AccentBackground}"/>
                <TextBlock Text="Дата регистрации" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="dpRegistrationDate" IsEnabled="False"/>
            </StackPanel>

            <!-- Смена пароля -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Сменить пароль" FontSize="17" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4"
                           Text="Оставьте поля пустыми, если пароль менять не нужно."/>
                <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pbCurrentPassword" MaxLength="50"/>
                <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pbNewPassword" MaxLength="50"/>
                <TextBlock Text="Повторите новый пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pbNewPasswordConfirm" MaxLength="50"/>
            </StackPanel>

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <Button x:Name="btnSaveChanges" Content="Сохранить изменения" Click="btnSaveChanges_Click"/>
                <Button x:Name="btnOrderHistory" Content="Мои заказы" Click="btnOrderHistory_Click"/>
                <Button x:Name="btnBack" Content="В каталог" Style="{StaticResource SecondaryButton}"
                        Click="btnBack_Click"/>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Page>
