<Page x:Class="TechnoMir.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация — ТехноМир">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Width="380" Margin="20">
            <TextBlock Text="Регистрация" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="После регистрации вы войдёте с ролью «Пользователь». Поля со звёздочкой обязательны."/>

            <TextBlock Text="Фамилия *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtSurname" MaxLength="100"/>
            <TextBlock Text="Имя *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtFirstName" MaxLength="100"/>
            <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtPatronymic" MaxLength="100"/>
            <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtEmail" MaxLength="150"/>
            <TextBlock Text="Телефон * (например, +7 912 345-67-89)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtPhone" MaxLength="20"/>
            <TextBlock Text="Пароль * (от 6 символов, буквы и цифры)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="pbPassword" MaxLength="50"/>
            <TextBlock Text="Повторите пароль *" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="pbPasswordConfirm" MaxLength="50"/>

            <Button x:Name="btnRegister" Content="Зарегистрироваться" Margin="0,14,0,4" Click="btnRegister_Click"/>
            <Button x:Name="btnBack" Content="Назад ко входу" Margin="0,4"
                    Style="{StaticResource SecondaryButton}" Click="btnBack_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
