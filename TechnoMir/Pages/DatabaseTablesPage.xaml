<Page x:Class="TechnoMir.Pages.DatabaseTablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблицы БД — ТехноМир">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Таблицы базы данных" Style="{StaticResource PageTitle}"/>

        <!-- Навигационное меню по таблицам -->
        <ListBox x:Name="lbTables" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                 DisplayMemberPath="Title" SelectionChanged="lbTables_SelectionChanged"
                 BorderBrush="{StaticResource BorderColor}" FontSize="15"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="txtHint" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <DataGrid x:Name="dgTable" Grid.Row="1" AutoGenerateColumns="True"
                      CanUserDeleteRows="False" SelectionMode="Extended"
                      AutoGeneratingColumn="dgTable_AutoGeneratingColumn"
                      InitializingNewItem="dgTable_InitializingNewItem"/>
        </Grid>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btnSaveChanges" Content="Сохранить изменения" Click="btnSaveChanges_Click"/>
            <Button x:Name="btnCancelChanges" Content="Отменить изменения" Style="{StaticResource SecondaryButton}"
                    Click="btnCancelChanges_Click"/>
            <Button x:Name="btnResetPassword" Content="Сбросить пароль" Style="{StaticResource SecondaryButton}"
                    Click="btnResetPassword_Click"/>
            <Button x:Name="btnDeleteRecord" Content="Удалить запись" Style="{StaticResource DangerButton}"
                    Click="btnDeleteRecord_Click"/>
            <Button x:Name="btnBack" Content="В каталог" Style="{StaticResource SecondaryButton}"
                    Click="btnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>
